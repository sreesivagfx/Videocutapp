# Copy to .env and fill in the providers you want to enable.
# Nothing here is required to run the MVP pipeline (transcription, auto-shorts,
# caption burning, noise removal, and basic TTS all work with no keys at all).

# --- Storage (defaults to local disk under backend/storage/) ---
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Translation provider (falls back to a local/offline stub if unset) ---
TRANSLATE_PROVIDER=stub   # stub | deepl | google
DEEPL_API_KEY=
GOOGLE_TRANSLATE_API_KEY=

# --- Text-to-speech provider (falls back to local pyttsx3 if unset) ---
TTS_PROVIDER=local        # local | elevenlabs | azure
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Voice cloning (disabled unless a provider key is set; consent required) ---
VOICE_CLONE_PROVIDER=disabled   # disabled | elevenlabs
VOICE_CLONE_API_KEY=

# --- Whisper model size: tiny | base | small | medium | large-v3 ---
WHISPER_MODEL_SIZE=base
